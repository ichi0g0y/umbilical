{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbilical",
  "identifier": "sh.ich.umbilical",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Umbilical",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Keeps claude remote-control running",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNkQwNUUxRENCNkNDMzcKUldRM3pMYmM0UVZ0WGhTMUZJc3dzMDZtaWVSVDJTZUZ2MDd5QzIyWVc3TnVVcWpBWlk1UG5FVjEK",
      "endpoints": [
        "https://github.com/ichi0g0y/umbilical/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
